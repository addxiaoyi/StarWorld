+  /** New receipt namespaces fail closed: silently dropping one could permit a duplicate payment. */
+  private static Map<String, NationSettlementService.SettlementReceipt> readSettlements(
+      Properties properties) {
+    Map<String, NationSettlementService.SettlementReceipt> result = new LinkedHashMap<>();
+    int count = receiptCount(properties, "settlement.");
+    for (int i = 0; i < count; i++) {
+      String prefix = "settlement." + i + ".";
+      var receipt =
+          new NationSettlementService.SettlementReceipt(
+              required(properties, prefix + "transactionId"),
+              strictNation(properties, prefix + "payerId"),
+              readAllocation(properties, prefix),
+              required(properties, prefix + "description"),
+              strictInstant(properties, prefix + "appliedAt"));
+      if (result.putIfAbsent(receipt.transactionId(), receipt) != null)
+        throw new IllegalArgumentException("Duplicate settlement receipt");
+    }
+    return result;
+  }
+
+  private static Map<String, NationSettlementService.SettlementRefundReceipt> readSettlementRefunds(
+      Properties properties) {
+    Map<String, NationSettlementService.SettlementRefundReceipt> result = new LinkedHashMap<>();
+    int count = receiptCount(properties, "settlement-refund.");
+    for (int i = 0; i < count; i++) {
+      String prefix = "settlement-refund." + i + ".";
+      var receipt =
+          new NationSettlementService.SettlementRefundReceipt(
+              required(properties, prefix + "transactionId"),
+              required(properties, prefix + "originalTransactionId"),
+              strictNation(properties, prefix + "payerId"),
+              readAllocation(properties, prefix),
+              strictInstant(properties, prefix + "appliedAt"));
+      if (result.putIfAbsent(receipt.transactionId(), receipt) != null)
+        throw new IllegalArgumentException("Duplicate settlement refund receipt");
+    }
+    return result;
+  }
+
+  private static int receiptCount(Properties properties, String prefix) {
+    String value = properties.getProperty(prefix + "count");
+    if (value == null) {
+      if (properties.stringPropertyNames().stream().anyMatch(key -> key.startsWith(prefix)))
+        throw new IllegalArgumentException("Missing receipt count: " + prefix);
+      return 0;
+    }
+    int count = Integer.parseInt(value);
+    if (count < 0 || count > properties.size())
+      throw new IllegalArgumentException("Invalid receipt count: " + prefix);
+    for (String key : properties.stringPropertyNames()) {
+      if (!key.startsWith(prefix) || key.equals(prefix + "count")) continue;
+      String suffix = key.substring(prefix.length());
+      int dot = suffix.indexOf('.');
+      if (dot < 1) throw new IllegalArgumentException("Invalid receipt property: " + key);
+      int index = Integer.parseInt(suffix.substring(0, dot));
+      if (index < 0 || index >= count)
+        throw new IllegalArgumentException("Orphan receipt property: " + key);
+    }
+    return count;
+  }
+
+  private static Map<NationId, BigDecimal> readAllocation(Properties properties, String prefix) {
+    int count = Integer.parseInt(required(properties, prefix + "credits"));
+    if (count < 1 || count > NationSettlementService.MAX_BENEFICIARIES)
+      throw new IllegalArgumentException("Invalid beneficiary count");
+    for (String key : properties.stringPropertyNames()) {
+      if (!key.startsWith(prefix + "credit.")) continue;
+      String suffix = key.substring((prefix + "credit.").length());
+      int dot = suffix.indexOf('.');
+      if (dot < 1) throw new IllegalArgumentException("Invalid beneficiary property");
+      int index = Integer.parseInt(suffix.substring(0, dot));
+      if (index < 0
+          || index >= count
+          || !List.of("nationId", "amount").contains(suffix.substring(dot + 1)))
+        throw new IllegalArgumentException("Orphan beneficiary property");
+    }
+    Map<NationId, BigDecimal> result = new LinkedHashMap<>();
+    for (int i = 0; i < count; i++) {
+      NationId nation = strictNation(properties, prefix + "credit." + i + ".nationId");
+      BigDecimal amount = new BigDecimal(required(properties, prefix + "credit." + i + ".amount"));
+      if (result.putIfAbsent(nation, amount) != null)
+        throw new IllegalArgumentException("Duplicate beneficiary");
+    }
+    return result;
+  }
+
+  private static void validateSettlements(TreasuryState state) {
+    java.util.Set<String> ids = new java.util.HashSet<>(state.transferReceipts().keySet());
+    ids.addAll(state.spendingReceipts().keySet());
+    ids.addAll(state.creditReceipts().keySet());
+    for (String id : state.settlementReceipts().keySet())
+      if (!ids.add(id)) throw new IllegalArgumentException("Settlement transaction ID collision");
+    java.util.Set<String> originals = new java.util.HashSet<>();
+    for (var refund : state.settlementRefundReceipts().values()) {
+      if (!ids.add(refund.transactionId()) || !originals.add(refund.originalTransactionId()))
+        throw new IllegalArgumentException("Duplicate refund transaction or original payment");
+      var settlement = state.settlementReceipts().get(refund.originalTransactionId());
+      var transfer = state.transferReceipts().get(refund.originalTransactionId());
+      NationId payer =
+          settlement != null ? settlement.payerId() : transfer != null ? transfer.payerId() : null;
+      Map<NationId, BigDecimal> credits =
+          settlement != null
+              ? settlement.credits()
+              : transfer != null ? Map.of(transfer.receiverId(), transfer.amount()) : Map.of();
+      if (!refund.payerId().equals(payer) || !refund.credits().equals(credits))
+        throw new IllegalArgumentException("Refund does not match its original committed payment");
+    }
+  }
+
+  private static String required(Properties properties, String key) {
+    String value = properties.getProperty(key);
+    if (value == null) throw new IllegalArgumentException("Missing treasury receipt field: " + key);
+    return value;
+  }
+
+  private static NationId strictNation(Properties properties, String key) {
+    return new NationId(UUID.fromString(required(properties, key)));
+  }
+
+  private static Instant strictInstant(Properties properties, String key) {
+    return Instant.ofEpochMilli(Long.parseLong(required(properties, key)));
   }
 
