+  @Override
+  public synchronized SettlementResult settle(SettlementRequest request) {
+    java.util.Objects.requireNonNull(request, "request");
+    SettlementReceipt existing = settlementReceipts.get(request.transactionId());
+    if (existing != null) {
+      return settlementResult(
+          existing.matches(request) && !refundedPayments.containsKey(request.transactionId())
+              ? SettlementStatus.ALREADY_APPLIED
+              : SettlementStatus.REJECTED,
+          request.transactionId(),
+          request.payerId(),
+          request.credits());
+    }
+    if (stateStorage == null || paymentIdInUse(request.transactionId())) {
+      return settlementResult(
+          SettlementStatus.REJECTED, request.transactionId(), request.payerId(), request.credits());
+    }
+    Map<NationId, BigDecimal> previous = settlementBalances(request.payerId(), request.credits());
+    BigDecimal total = request.total();
+    if (previous.get(request.payerId()).compareTo(total) < 0) {
+      return new SettlementResult(
+          SettlementStatus.INSUFFICIENT_FUNDS, request.transactionId(), previous);
+    }
+    for (var credit : request.credits().entrySet()) {
+      if (previous.get(credit.getKey()).add(credit.getValue()).compareTo(MAX_TREASURY_BALANCE)
+          > 0) {
+        return new SettlementResult(SettlementStatus.REJECTED, request.transactionId(), previous);
+      }
+    }
+    SettlementReceipt receipt =
+        new SettlementReceipt(
+            request.transactionId(),
+            request.payerId(),
+            request.credits(),
+            request.description(),
+            Instant.now());
+    balances.put(request.payerId(), previous.get(request.payerId()).subtract(total));
+    request
+        .credits()
+        .forEach((nation, amount) -> balances.put(nation, previous.get(nation).add(amount)));
+    settlementReceipts.put(request.transactionId(), receipt);
+    try {
+      saveStateSyncOrThrow();
+      return settlementResult(
+          SettlementStatus.APPLIED, request.transactionId(), request.payerId(), request.credits());
+    } catch (RuntimeException failure) {
+      settlementReceipts.remove(request.transactionId(), receipt);
+      previous.forEach(this::restoreBalance);
+      logPersistenceFailure("settlement", request.payerId(), total, failure);
+      return settlementResult(
+          SettlementStatus.REJECTED, request.transactionId(), request.payerId(), request.credits());
+    }
+  }
+
+  @Override
+  public synchronized Optional<SettlementReceipt> settlementReceipt(String transactionId) {
+    return transactionId == null
+        ? Optional.empty()
+        : Optional.ofNullable(settlementReceipts.get(transactionId));
+  }
+
+  @Override
+  public synchronized SettlementResult refundSettlement(SettlementRefundRequest request) {
+    java.util.Objects.requireNonNull(request, "request");
+    SettlementRefundReceipt existing = settlementRefundReceipts.get(request.transactionId());
+    if (existing != null) {
+      return settlementResult(
+          existing.originalTransactionId().equals(request.originalTransactionId())
+              ? SettlementStatus.ALREADY_APPLIED
+              : SettlementStatus.REJECTED,
+          request.transactionId(),
+          existing.payerId(),
+          existing.credits());
+    }
+    if (stateStorage == null
+        || paymentIdInUse(request.transactionId())
+        || refundedPayments.containsKey(request.originalTransactionId())) {
+      return new SettlementResult(SettlementStatus.REJECTED, request.transactionId(), Map.of());
+    }
+    SettlementReceipt original = settlementReceipts.get(request.originalTransactionId());
+    if (original == null) {
+      TransferReceipt transfer = transferReceipts.get(request.originalTransactionId());
+      if (transfer == null)
+        return new SettlementResult(SettlementStatus.REJECTED, request.transactionId(), Map.of());
+      original =
+          new SettlementReceipt(
+              transfer.transactionId(),
+              transfer.payerId(),
+              Map.of(transfer.receiverId(), transfer.amount()),
+              "",
+              transfer.appliedAt());
+    }
+    NationId payer = original.payerId();
+    Map<NationId, BigDecimal> credits = original.credits();
+    Map<NationId, BigDecimal> previous = settlementBalances(payer, credits);
+    BigDecimal total = credits.values().stream().reduce(BigDecimal.ZERO, BigDecimal::add);
+    if (previous.get(payer).add(total).compareTo(MAX_TREASURY_BALANCE) > 0)
+      return new SettlementResult(SettlementStatus.REJECTED, request.transactionId(), previous);
+    for (var credit : credits.entrySet()) {
+      if (previous.get(credit.getKey()).compareTo(credit.getValue()) < 0)
+        return new SettlementResult(
+            SettlementStatus.INSUFFICIENT_FUNDS, request.transactionId(), previous);
+    }
+    SettlementRefundReceipt receipt =
+        new SettlementRefundReceipt(
+            request.transactionId(),
+            request.originalTransactionId(),
+            payer,
+            credits,
+            Instant.now());
+    credits.forEach(
+        (nation, amount) -> balances.put(nation, previous.get(nation).subtract(amount)));
+    balances.put(payer, previous.get(payer).add(total));
+    settlementRefundReceipts.put(request.transactionId(), receipt);
+    refundedPayments.put(request.originalTransactionId(), receipt);
+    try {
+      saveStateSyncOrThrow();
+      return settlementResult(SettlementStatus.APPLIED, request.transactionId(), payer, credits);
+    } catch (RuntimeException failure) {
+      settlementRefundReceipts.remove(request.transactionId(), receipt);
+      refundedPayments.remove(request.originalTransactionId(), receipt);
+      previous.forEach(this::restoreBalance);
+      logPersistenceFailure("settlement-refund", payer, total, failure);
+      return settlementResult(SettlementStatus.REJECTED, request.transactionId(), payer, credits);
+    }
+  }
+
+  @Override
+  public synchronized Optional<SettlementRefundReceipt> settlementRefundReceipt(
+      String transactionId) {
+    return transactionId == null
+        ? Optional.empty()
+        : Optional.ofNullable(settlementRefundReceipts.get(transactionId));
+  }
+
+  @Override
+  public synchronized Optional<SettlementRefundReceipt> refundForPayment(
+      String originalTransactionId) {
+    return originalTransactionId == null
+        ? Optional.empty()
+        : Optional.ofNullable(refundedPayments.get(originalTransactionId));
+  }
+
+  private boolean paymentIdInUse(String id) {
+    return spendingReceipts.containsKey(id)
+        || creditReceipts.containsKey(id)
+        || transferReceipts.containsKey(id)
+        || settlementReceipts.containsKey(id)
+        || settlementRefundReceipts.containsKey(id);
+  }
+
+  private Map<NationId, BigDecimal> settlementBalances(
+      NationId payer, Map<NationId, BigDecimal> credits) {
+    Map<NationId, BigDecimal> result = new LinkedHashMap<>();
+    result.put(payer, balance(payer));
+    credits.keySet().forEach(nation -> result.put(nation, balance(nation)));
+    return result;
+  }
+
+  private SettlementResult settlementResult(
+      SettlementStatus status, String id, NationId payer, Map<NationId, BigDecimal> credits) {
+    return new SettlementResult(status, id, settlementBalances(payer, credits));
+  }
