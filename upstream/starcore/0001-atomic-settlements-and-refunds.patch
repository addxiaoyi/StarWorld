@@ -0,0 +1,155 @@
+package dev.starcore.starcore.module.treasury;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.Instant;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Optional;
+
+/**
+ * Atomic national payments with at most sixteen beneficiaries and verifiable full reversals.
+ * Callers authorize the economic operation; this service never charges a player wallet or mints
+ * money. A payment and every affected balance share one durable treasury commit. Refunds reverse
+ * exactly the original payment, including every beneficiary, and can succeed only once.
+ */
+public interface NationSettlementService {
+  int MAX_BENEFICIARIES = 16;
+
+  enum SettlementStatus {
+    APPLIED,
+    ALREADY_APPLIED,
+    INSUFFICIENT_FUNDS,
+    REJECTED
+  }
+
+  record SettlementRequest(
+      String transactionId,
+      NationId payerId,
+      Map<NationId, BigDecimal> credits,
+      String description) {
+    public SettlementRequest {
+      transactionId = identifier(transactionId);
+      payerId = Objects.requireNonNull(payerId, "payerId");
+      credits = allocation(payerId, credits);
+      description = description == null ? "" : description;
+      if (description.length() > 512) throw new IllegalArgumentException("Description too long");
+    }
+
+    public BigDecimal total() {
+      return credits.values().stream().reduce(new BigDecimal("0.00"), BigDecimal::add);
+    }
+  }
+
+  record SettlementReceipt(
+      String transactionId,
+      NationId payerId,
+      Map<NationId, BigDecimal> credits,
+      String description,
+      Instant appliedAt) {
+    public SettlementReceipt {
+      SettlementRequest checked =
+          new SettlementRequest(transactionId, payerId, credits, description);
+      transactionId = checked.transactionId();
+      payerId = checked.payerId();
+      credits = checked.credits();
+      description = checked.description();
+      appliedAt = Objects.requireNonNull(appliedAt, "appliedAt");
+    }
+
+    public boolean matches(SettlementRequest request) {
+      return transactionId.equals(request.transactionId())
+          && payerId.equals(request.payerId())
+          && credits.equals(request.credits())
+          && description.equals(request.description());
+    }
+  }
+
+  /** Original payment may be a settlement or an existing NationTransferService transfer. */
+  record SettlementRefundRequest(String transactionId, String originalTransactionId) {
+    public SettlementRefundRequest {
+      transactionId = identifier(transactionId);
+      originalTransactionId = identifier(originalTransactionId);
+      if (transactionId.equals(originalTransactionId))
+        throw new IllegalArgumentException("Refund must have its own transaction ID");
+    }
+  }
+
+  /** credits describes the original beneficiaries; the refund debits them and restores payerId. */
+  record SettlementRefundReceipt(
+      String transactionId,
+      String originalTransactionId,
+      NationId payerId,
+      Map<NationId, BigDecimal> credits,
+      Instant appliedAt) {
+    public SettlementRefundReceipt {
+      SettlementRefundRequest checked =
+          new SettlementRefundRequest(transactionId, originalTransactionId);
+      transactionId = checked.transactionId();
+      originalTransactionId = checked.originalTransactionId();
+      payerId = Objects.requireNonNull(payerId, "payerId");
+      credits = allocation(payerId, credits);
+      appliedAt = Objects.requireNonNull(appliedAt, "appliedAt");
+    }
+  }
+
+  record SettlementResult(
+      SettlementStatus status, String transactionId, Map<NationId, BigDecimal> balancesAfter) {
+    public SettlementResult {
+      status = Objects.requireNonNull(status, "status");
+      transactionId = identifier(transactionId);
+      balancesAfter = Map.copyOf(balancesAfter);
+    }
+
+    public boolean applied() {
+      return status == SettlementStatus.APPLIED || status == SettlementStatus.ALREADY_APPLIED;
+    }
+  }
+
+  SettlementResult settle(SettlementRequest request);
+
+  Optional<SettlementReceipt> settlementReceipt(String transactionId);
+
+  SettlementResult refundSettlement(SettlementRefundRequest request);
+
+  Optional<SettlementRefundReceipt> settlementRefundReceipt(String transactionId);
+
+  Optional<SettlementRefundReceipt> refundForPayment(String originalTransactionId);
+
+  private static String identifier(String value) {
+    if (value == null || value.isBlank() || value.length() > 200)
+      throw new IllegalArgumentException("Invalid settlement transaction ID");
+    return value;
+  }
+
+  private static Map<NationId, BigDecimal> allocation(
+      NationId payer, Map<NationId, BigDecimal> input) {
+    if (input == null || input.isEmpty() || input.size() > MAX_BENEFICIARIES)
+      throw new IllegalArgumentException("A settlement requires one to sixteen beneficiaries");
+    Map<NationId, BigDecimal> result = new LinkedHashMap<>();
+    BigDecimal total = BigDecimal.ZERO;
+    for (var entry : input.entrySet()) {
+      NationId receiver = Objects.requireNonNull(entry.getKey(), "receiverId");
+      if (payer.equals(receiver))
+        throw new IllegalArgumentException("Payer cannot be a beneficiary");
+      BigDecimal value = Objects.requireNonNull(entry.getValue(), "amount");
+      if (value.scale() > 64
+          || value.precision() > 80
+          || value.signum() <= 0
+          || value.compareTo(new BigDecimal("1000000000000000.00")) > 0)
+        throw new IllegalArgumentException("Invalid settlement amount");
+      try {
+        value = value.setScale(2, RoundingMode.UNNECESSARY);
+      } catch (ArithmeticException invalid) {
+        throw new IllegalArgumentException("Settlement amounts require exact cents", invalid);
+      }
+      total = total.add(value);
+      result.put(receiver, value);
+    }
+    if (total.compareTo(new BigDecimal("1000000000000000.00")) > 0)
+      throw new IllegalArgumentException("Settlement total exceeds treasury cap");
+    return Map.copyOf(result);
+  }
+}
