@@ -0,0 +1,122 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import dev.starcore.starcore.core.StarCoreContext;
+import dev.starcore.starcore.core.service.ServiceRegistry;
+import dev.starcore.starcore.foundation.territory.model.*;
+import dev.starcore.starcore.module.city.CityService;
+import dev.starcore.starcore.module.city.model.City;
+import dev.starcore.starcore.module.diplomacy.TransitPermitService.*;
+import dev.starcore.starcore.module.nation.NationService;
+import dev.starcore.starcore.module.nation.model.Nation;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.war.WarService;
+import java.math.BigDecimal;
+import java.util.*;
+import org.bukkit.Server;
+import org.bukkit.World;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.junit.jupiter.api.Test;
+
+class CoreTransitAuthorityTest {
+  final StarCoreContext context = mock(StarCoreContext.class);
+  final ServiceRegistry services = new ServiceRegistry();
+  final NationService nations = mock(NationService.class);
+  final CityService cities = mock(CityService.class);
+  final DiplomacyRelationService diplomacy = mock(DiplomacyRelationService.class);
+  final WarService wars = mock(WarService.class);
+  final JavaPlugin plugin = mock(JavaPlugin.class);
+  final Server server = mock(Server.class);
+  final World world = mock(World.class);
+  final City city = mock(City.class);
+  final UUID player = UUID.randomUUID(), cityId = UUID.randomUUID(), worldId = UUID.randomUUID();
+  final NationId grantor = NationId.random(),
+      origin = NationId.random(),
+      target = NationId.random();
+  final Terms terms =
+      new Terms(
+          "starworld:route",
+          "a".repeat(64),
+          grantor,
+          origin,
+          target,
+          Set.of(new Parcel(worldId, "world", cityId, 1, -2)),
+          new BigDecimal("0.05"),
+          Long.MAX_VALUE);
+  final CoreTransitAuthority authority;
+
+  CoreTransitAuthorityTest() {
+    when(context.serviceRegistry()).thenReturn(services);
+    when(context.plugin()).thenReturn(plugin);
+    when(plugin.getServer()).thenReturn(server);
+    when(server.getWorld(worldId)).thenReturn(world);
+    when(world.getName()).thenReturn("world");
+    services.register(CityService.class, cities);
+    services.register(WarService.class, wars);
+    for (NationId id : List.of(grantor, origin, target)) {
+      Nation nation = mock(Nation.class);
+      when(nation.id()).thenReturn(id);
+      when(nations.nationById(id)).thenReturn(Optional.of(nation));
+      if (id.equals(grantor)) when(nations.nationOf(player)).thenReturn(Optional.of(nation));
+    }
+    when(nations.isFounder(player, grantor)).thenReturn(true);
+    when(cities.getCity(cityId)).thenReturn(Optional.of(city));
+    when(city.nationId()).thenReturn(grantor);
+    when(city.hasClaim("world", 1, -2)).thenReturn(true);
+    when(nations.claimAt("world", 1, -2))
+        .thenReturn(
+            Optional.of(
+                new TerritoryClaim(grantor.toString(), new ChunkCoordinate("world", 1, -2))));
+    for (NationId peer : List.of(origin, target))
+      when(diplomacy.relationBetween(grantor, peer)).thenReturn(DiplomacyRelation.NEUTRAL);
+    authority = new CoreTransitAuthority(context, nations, diplomacy);
+  }
+
+  @Test
+  void bothClaimLayersAndBothForeignRelationsAreRequiredWithoutLoadingAnyChunk() {
+    assertThat(authority.limitation(terms)).isNull();
+    verify(world).getName();
+    verifyNoMoreInteractions(world);
+    when(city.hasClaim("world", 1, -2)).thenReturn(false);
+    assertThat(authority.limitation(terms)).contains("city");
+    when(city.hasClaim("world", 1, -2)).thenReturn(true);
+    when(nations.claimAt("world", 1, -2)).thenReturn(Optional.empty());
+    assertThat(authority.limitation(terms)).contains("national");
+    when(nations.claimAt("world", 1, -2))
+        .thenReturn(
+            Optional.of(
+                new TerritoryClaim(origin.toString(), new ChunkCoordinate("world", 1, -2))));
+    assertThat(authority.limitation(terms)).contains("national");
+  }
+
+  @Test
+  void warHostilityUnknownServicesAndLostCityOrNationAllBlockPermission() {
+    when(wars.atWar(grantor, origin)).thenReturn(true);
+    assertThat(authority.limitation(terms)).contains("war");
+    when(wars.atWar(grantor, origin)).thenReturn(false);
+    when(diplomacy.relationBetween(grantor, target)).thenReturn(DiplomacyRelation.HOSTILE);
+    assertThat(authority.limitation(terms)).contains("diplomacy");
+    when(diplomacy.relationBetween(grantor, target)).thenReturn(DiplomacyRelation.NEUTRAL);
+    when(city.nationId()).thenReturn(origin);
+    assertThat(authority.limitation(terms)).contains("ownership");
+    when(city.nationId()).thenReturn(grantor);
+    when(nations.nationById(target)).thenReturn(Optional.empty());
+    assertThat(authority.limitation(terms)).contains("no longer exists");
+    services.unregister(WarService.class);
+    assertThat(authority.limitation(terms)).contains("unavailable");
+  }
+
+  @Test
+  void founderClaimRequiresCurrentMembershipAndWorldIdentityMustStillMatch() {
+    assertThatCode(() -> authority.requireFounder(player, grantor)).doesNotThrowAnyException();
+    when(nations.nationOf(player)).thenReturn(Optional.empty());
+    assertThatThrownBy(() -> authority.requireFounder(player, grantor))
+        .hasMessageContaining("founder");
+    when(world.getName()).thenReturn("renamed");
+    assertThat(authority.limitation(terms)).contains("renamed");
+    when(server.getWorld(worldId)).thenReturn(null);
+    assertThat(authority.limitation(terms)).contains("unavailable");
+  }
+}
diff --git a/src/test/java/dev/starcore/starcore/module/diplomacy/TransitPermitLedgerTest.java b/src/test/java/dev/starcore/starcore/module/diplomacy/TransitPermitLedgerTest.java
new file mode 100644
index 00000000..9ba44c9f
--- /dev/null
+++ b/src/test/java/dev/starcore/starcore/module/diplomacy/TransitPermitLedgerTest.java
@@ -0,0 +1,347 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import static org.assertj.core.api.Assertions.*;
+
+import com.zaxxer.hikari.HikariConfig;
+import com.zaxxer.hikari.HikariDataSource;
+import dev.starcore.starcore.module.diplomacy.TransitPermitService.*;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.math.BigDecimal;
+import java.nio.file.Path;
+import java.time.*;
+import java.util.*;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.function.Consumer;
+import java.util.logging.Logger;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class TransitPermitLedgerTest {
+  @TempDir Path temp;
+  final UUID actor = UUID.randomUUID(), world = UUID.randomUUID(), city = UUID.randomUUID();
+  final NationId grantor = NationId.random(),
+      origin = NationId.random(),
+      target = NationId.random();
+  final long now = Instant.parse("2026-11-25T00:00:00Z").toEpochMilli();
+  final Clock clock = Clock.fixed(Instant.ofEpochMilli(now), ZoneOffset.UTC);
+
+  final class Authority implements TransitPermitLedger.Authority {
+    boolean founder = true;
+    String reason;
+
+    @Override
+    public void requireFounder(UUID player, NationId nation) {
+      if (!founder || !player.equals(actor) || !nation.equals(grantor))
+        throw new IllegalArgumentException("founder");
+    }
+
+    @Override
+    public String limitation(Terms terms) {
+      return reason;
+    }
+  }
+
+  final class Memory {
+    Properties state = new Properties();
+    int writes;
+
+    void save(Properties value) {
+      state = new Properties();
+      state.putAll(value);
+      writes++;
+    }
+  }
+
+  Terms terms(String route) {
+    return new Terms(
+        route,
+        "a".repeat(64),
+        grantor,
+        origin,
+        target,
+        Set.of(new Parcel(world, "world", city, 10, -20)),
+        new BigDecimal("0.03"),
+        now + 60_000);
+  }
+
+  TransitPermitLedger ledger(
+      Authority authority, Consumer<Properties> save, Properties initial, Clock time) {
+    var ledger = new TransitPermitLedger(new Object(), () -> {}, authority, save, time);
+    ledger.restore(initial);
+    return ledger;
+  }
+
+  TransitPermitLedger ledger(Authority authority, Memory data) {
+    return ledger(authority, data::save, data.state, clock);
+  }
+
+  Approval approval(Terms terms, long revision) {
+    return new Approval(UUID.randomUUID(), actor, revision, terms);
+  }
+
+  @Test
+  void approvalRevocationAndOldRequestReplaySurviveRestartWithoutRestoringOldRights() {
+    var auth = new Authority();
+    var data = new Memory();
+    var service = ledger(auth, data);
+    Terms terms = terms("starworld:route");
+    Approval request = approval(terms, 0);
+    Receipt approved = service.approve(request);
+    assertThat(approved.permit().revision()).isEqualTo(1);
+    assertThat(service.evaluate(terms, 1).allowed()).isTrue();
+    var revoke = new Revocation(UUID.randomUUID(), actor, 1, terms.routeKey(), grantor);
+    Receipt revoked = service.revoke(revoke);
+    assertThat(revoked.permit().revision()).isEqualTo(2);
+    assertThat(service.approve(request)).isEqualTo(approved);
+    assertThat(service.revoke(revoke)).isEqualTo(revoked);
+    assertThat(data.writes).isEqualTo(2);
+    service = ledger(auth, data);
+    assertThat(service.receipt(request.requestId())).contains(approved);
+    assertThat(service.approve(request)).isEqualTo(approved);
+    assertThat(service.evaluate(terms, 1).allowed()).isFalse();
+    assertThat(service.evaluate(terms, 2).allowed()).isFalse();
+    assertThat(service.permit(terms.routeKey(), grantor)).contains(revoked.permit());
+    Receipt restored = service.approve(approval(terms, 2));
+    assertThat(restored.permit().revision()).isEqualTo(3);
+    assertThat(service.evaluate(terms, 2).allowed()).isFalse();
+    assertThat(service.evaluate(terms, 3).allowed()).isTrue();
+  }
+
+  @Test
+  void actorRevisionAndRequestConflictsAreRejectedWithoutReplacingTheOriginalReceipt() {
+    var auth = new Authority();
+    var data = new Memory();
+    var service = ledger(auth, data);
+    Terms terms = terms("route");
+    Approval request = approval(terms, 0);
+    Receipt receipt = service.approve(request);
+    assertThatThrownBy(() -> service.approve(approval(terms, 0))).hasMessageContaining("revision");
+    Terms changed =
+        new Terms(
+            terms.routeKey(),
+            terms.fingerprint(),
+            grantor,
+            origin,
+            target,
+            terms.parcels(),
+            new BigDecimal("0.04"),
+            terms.expiresAt());
+    assertThatThrownBy(() -> service.approve(new Approval(request.requestId(), actor, 0, changed)))
+        .hasMessageContaining("conflicts");
+    assertThatThrownBy(
+            () -> service.revoke(new Revocation(request.requestId(), actor, 1, "route", grantor)))
+        .hasMessageContaining("conflicts");
+    auth.founder = false;
+    assertThatThrownBy(() -> service.approve(request)).hasMessageContaining("founder");
+    assertThatThrownBy(
+            () -> service.revoke(new Revocation(UUID.randomUUID(), actor, 1, "route", grantor)))
+        .hasMessageContaining("founder");
+    assertThat(data.writes).isEqualTo(1);
+    assertThat(service.receipt(request.requestId())).contains(receipt);
+  }
+
+  @Test
+  void changedClaimsWarExpiryAndClockRollbackDenyEvenWithUnchangedPermitRevision() {
+    var auth = new Authority();
+    var data = new Memory();
+    var service = ledger(auth, data);
+    Terms terms = terms("route");
+    service.approve(approval(terms, 0));
+    for (String reason :
+        List.of("lost city claim", "lost nation claim", "war", "missing service")) {
+      auth.reason = reason;
+      assertThat(service.evaluate(terms, 1).allowed()).isFalse();
+      assertThatThrownBy(() -> service.approve(approval(terms, 1))).hasMessageContaining(reason);
+    }
+    auth.reason = null;
+    assertThat(service.evaluate(terms, 1).allowed()).isTrue();
+    assertThat(
+            ledger(
+                    auth,
+                    data::save,
+                    data.state,
+                    Clock.fixed(Instant.ofEpochMilli(terms.expiresAt()), ZoneOffset.UTC))
+                .evaluate(terms, 1)
+                .allowed())
+        .isFalse();
+    assertThat(
+            ledger(
+                    auth,
+                    data::save,
+                    data.state,
+                    Clock.fixed(Instant.ofEpochMilli(now - 1), ZoneOffset.UTC))
+                .evaluate(terms, 1)
+                .allowed())
+        .isFalse();
+    assertThat(data.writes).isEqualTo(1);
+  }
+
+  @Test
+  void activePermitBoundCountsOnlyLivePermissionsAndNeverPreventsRevocation() {
+    var auth = new Authority();
+    var data = new Memory();
+    var service = ledger(auth, data);
+    for (int i = 0; i < 64; i++) service.approve(approval(terms("route:" + i), 0));
+    assertThatThrownBy(() -> service.approve(approval(terms("route:64"), 0)))
+        .hasMessageContaining("limit");
+    service.revoke(new Revocation(UUID.randomUUID(), actor, 1, "route:0", grantor));
+    service.approve(approval(terms("route:64"), 0));
+    assertThat(service.evaluate(terms("route:64"), 1).allowed()).isTrue();
+  }
+
+  @Test
+  void failedSaveAndLostAcknowledgementDisableReadsAndWritesUntilDurableReload() {
+    for (boolean committed : List.of(false, true)) {
+      var auth = new Authority();
+      var data = new Memory();
+      Approval request = approval(terms("route"), 0);
+      var service =
+          ledger(
+              auth,
+              properties -> {
+                if (committed) data.save(properties);
+                throw new IllegalStateException("lost persistence acknowledgement");
+              },
+              data.state,
+              clock);
+      assertThatThrownBy(() -> service.approve(request)).hasMessageContaining("acknowledgement");
+      assertThatThrownBy(() -> service.evaluate(request.terms(), 1)).hasMessageContaining("reload");
+      assertThatThrownBy(service::properties).hasMessageContaining("Uncertain");
+      assertThatThrownBy(() -> service.approve(request)).hasMessageContaining("reload");
+      var restarted = ledger(auth, data);
+      Receipt result = restarted.approve(request);
+      assertThat(result.permit().revision()).isEqualTo(1);
+      assertThat(data.writes).isEqualTo(1);
+      assertThat(restarted.evaluate(request.terms(), 1).allowed()).isTrue();
+    }
+  }
+
+  @Test
+  void corruptReceiptsRevisionsAndUnknownFieldsCannotLoadAsPermission() {
+    var auth = new Authority();
+    var data = new Memory();
+    var service = ledger(auth, data);
+    service.approve(approval(terms("route"), 0));
+    service.revoke(new Revocation(UUID.randomUUID(), actor, 1, "route", grantor));
+    List<Consumer<Properties>> changes =
+        List.of(
+            p -> p.remove("transit.version"), p -> p.setProperty("transit.version", "2"),
+            p -> p.setProperty("transit.permit.0.revoked", "no"),
+                p -> p.setProperty("transit.permit.0.revision", "1"),
+            p -> p.setProperty("transit.receipts", "1"),
+                p -> p.setProperty("transit.permit.0.parcels", "129"),
+            p -> p.setProperty("transit.permit.0.toll", "0.031"),
+                p -> p.setProperty("transit.unrecognized", "unsafe"));
+    for (var change : changes) {
+      Properties invalid = new Properties();
+      invalid.putAll(data.state);
+      change.accept(invalid);
+      assertThatThrownBy(() -> ledger(auth, data::save, invalid, clock))
+          .isInstanceOf(RuntimeException.class);
+      assertThatThrownBy(() -> service.restore(invalid)).isInstanceOf(RuntimeException.class);
+      assertThatThrownBy(() -> service.evaluate(terms("route"), 2)).hasMessageContaining("reload");
+      service.restore(data.state);
+    }
+  }
+
+  @Test
+  void restoreRejectsConsistentlyAlteredExpiryAndConsecutiveRevocations() {
+    var auth = new Authority();
+    var data = new Memory();
+    var service = ledger(auth, data);
+    service.approve(approval(terms("route"), 0));
+    for (long expiry : List.of(now, now + Duration.ofDays(31).toMillis())) {
+      Properties invalid = new Properties();
+      invalid.putAll(data.state);
+      invalid.setProperty("transit.permit.0.expiry", "" + expiry);
+      invalid.setProperty("transit.receipt.0.result.expiry", "" + expiry);
+      assertThatThrownBy(() -> ledger(auth, data::save, invalid, clock))
+          .hasMessageContaining("expiry");
+    }
+    service.revoke(new Revocation(UUID.randomUUID(), actor, 1, "route", grantor));
+    service.approve(approval(terms("route"), 2));
+    Properties invalid = new Properties();
+    invalid.putAll(data.state);
+    invalid.setProperty("transit.permit.0.revoked", "true");
+    for (int i = 0; i < 3; i++) {
+      String prefix = "transit.receipt." + i + ".";
+      if ("3".equals(invalid.getProperty(prefix + "result.revision"))) {
+        invalid.setProperty(prefix + "action", "REVOKE");
+        invalid.setProperty(prefix + "result.revoked", "true");
+      }
+    }
+    assertThatThrownBy(() -> ledger(auth, data::save, invalid, clock))
+        .hasMessageContaining("revocation history");
+  }
+
+  @Test
+  void closedServiceOrWrongThreadNeverPersistsOrReadsAuthority() {
+    var auth = new Authority();
+    var data = new Memory();
+    AtomicBoolean main = new AtomicBoolean(false);
+    var service =
+        new TransitPermitLedger(
+            new Object(),
+            () -> {
+              if (!main.get()) throw new IllegalStateException("wrong thread");
+            },
+            auth,
+            data::save,
+            clock);
+    service.restore(data.state);
+    assertThatThrownBy(() -> service.approve(approval(terms("route"), 0)))
+        .hasMessageContaining("thread");
+    main.set(true);
+    service.close();
+    assertThatThrownBy(() -> service.approve(approval(terms("route"), 0)))
+        .hasMessageContaining("closed");
+    assertThat(data.writes).isZero();
+  }
