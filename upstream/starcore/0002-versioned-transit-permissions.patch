@@ -0,0 +1,68 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import dev.starcore.starcore.core.StarCoreContext;
+import dev.starcore.starcore.module.city.CityService;
+import dev.starcore.starcore.module.diplomacy.TransitPermitService.Terms;
+import dev.starcore.starcore.module.nation.NationService;
+import dev.starcore.starcore.module.nation.model.NationId;
+import dev.starcore.starcore.module.war.WarService;
+import java.util.Objects;
+import java.util.UUID;
+
+/**
+ * Checks live core authority. Reads claims only and never loads chunks or inspects private models.
+ */
+final class CoreTransitAuthority implements TransitPermitLedger.Authority {
+  private final StarCoreContext context;
+  private final NationService nations;
+  private final DiplomacyRelationService diplomacy;
+
+  CoreTransitAuthority(
+      StarCoreContext context, NationService nations, DiplomacyRelationService diplomacy) {
+    this.context = Objects.requireNonNull(context);
+    this.nations = Objects.requireNonNull(nations);
+    this.diplomacy = Objects.requireNonNull(diplomacy);
+  }
+
+  @Override
+  public void requireFounder(UUID actor, NationId nation) {
+    if (!nations.isFounder(actor, nation)
+        || nations.nationOf(actor).filter(n -> n.id().equals(nation)).isEmpty())
+      throw new IllegalArgumentException(
+          "Transit permission requires the current granting nation's founder");
+  }
+
+  @Override
+  public String limitation(Terms terms) {
+    CityService cities = context.serviceRegistry().find(CityService.class).orElse(null);
+    WarService wars = context.serviceRegistry().find(WarService.class).orElse(null);
+    if (cities == null || wars == null) return "City or war authority is unavailable";
+    if (nations.nationById(terms.grantingNation()).isEmpty()
+        || nations.nationById(terms.originNation()).isEmpty()
+        || nations.nationById(terms.targetNation()).isEmpty())
+      return "A corridor nation no longer exists";
+    for (NationId peer : java.util.List.of(terms.originNation(), terms.targetNation())) {
+      DiplomacyRelation relation = diplomacy.relationBetween(terms.grantingNation(), peer);
+      if (relation == null
+          || relation == DiplomacyRelation.HOSTILE
+          || relation == DiplomacyRelation.WAR
+          || wars.atWar(terms.grantingNation(), peer))
+        return "Transit is blocked by diplomacy or war";
+    }
+    for (var parcel : terms.parcels()) {
+      var world = context.plugin().getServer().getWorld(parcel.worldId());
+      if (world == null || !world.getName().equals(parcel.worldName()))
+        return "Transit world is unavailable or renamed";
+      var city = cities.getCity(parcel.cityId()).orElse(null);
+      if (city == null
+          || !city.nationId().equals(terms.grantingNation())
+          || !city.hasClaim(parcel.worldName(), parcel.chunkX(), parcel.chunkZ()))
+        return "Transit city ownership or claim changed";
+      var claim =
+          nations.claimAt(parcel.worldName(), parcel.chunkX(), parcel.chunkZ()).orElse(null);
+      if (claim == null || !terms.grantingNation().toString().equals(claim.ownerId()))
+        return "Transit national claim changed";
+    }
+    return null;
+  }
+}
