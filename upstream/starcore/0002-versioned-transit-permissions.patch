+
+  private void persistTransit(Properties update) {
+    synchronized (statePersistenceLock) {
+      if (stateStorage == null)
+        throw new IllegalStateException("Durable transit storage unavailable");
+      Properties combined = stateProperties();
+      combined
+          .keySet()
+          .removeIf(
+              key -> key instanceof String text && text.startsWith(TransitPermitLedger.PREFIX));
+      combined.putAll(update);
+      stateStorage.save(combined);
+    }
   }
 
   private void loadState() {
     Properties properties = stateStorage == null ? new Properties() : stateStorage.load();
+    if (transitPermits != null) transitPermits.restore(properties);
     relations.clear();
     relations.putAll(DiplomacyStateCodec.fromProperties(properties));
     warRecords.clear();
