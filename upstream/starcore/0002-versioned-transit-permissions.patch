diff --git a/src/main/java/dev/starcore/starcore/module/diplomacy/TransitPermitLedger.java b/src/main/java/dev/starcore/starcore/module/diplomacy/TransitPermitLedger.java
new file mode 100644
index 00000000..25669788
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/diplomacy/TransitPermitLedger.java
@@ -0,0 +1,412 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import dev.starcore.starcore.module.diplomacy.TransitPermitService.*;
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.math.BigDecimal;
+import java.time.Clock;
+import java.time.Duration;
+import java.util.*;
+import java.util.function.Consumer;
+
+/**
+ * Exact immutable permit snapshots, persisted before publication. No world or treasury mutation.
+ */
+final class TransitPermitLedger implements TransitPermitService {
+  static final String PREFIX = "transit.";
+  private static final int MAX_RECEIPTS = 100_000;
+  private static final long MAX_LIFETIME = Duration.ofDays(30).toMillis();
+
+  interface Authority {
+    void requireFounder(UUID actor, NationId nation);
+
+    String limitation(Terms terms);
+  }
+
+  private record Key(String route, NationId nation) {}
+
+  private final Object lock;
+  private final Runnable thread;
+  private final Authority authority;
+  private final Consumer<Properties> persist;
+  private final Clock clock;
+  private Map<Key, Permit> permits = new LinkedHashMap<>();
+  private Map<UUID, Receipt> receipts = new LinkedHashMap<>();
+  private boolean closed;
+  private boolean storageUncertain = true;
+
+  TransitPermitLedger(
+      Object lock,
+      Runnable thread,
+      Authority authority,
+      Consumer<Properties> persist,
+      Clock clock) {
+    this.lock = Objects.requireNonNull(lock);
+    this.thread = Objects.requireNonNull(thread);
+    this.authority = Objects.requireNonNull(authority);
+    this.persist = Objects.requireNonNull(persist);
+    this.clock = Objects.requireNonNull(clock);
+  }
+
+  @Override
+  public Receipt approve(Approval request) {
+    Objects.requireNonNull(request);
+    check();
+    synchronized (lock) {
+      authority.requireFounder(request.actor(), request.terms().grantingNation());
+      Receipt old = receipts.get(request.requestId());
+      if (old != null) {
+        if (old.action() != Action.APPROVE
+            || old.expectedRevision() != request.expectedRevision()
+            || !old.permit().actor().equals(request.actor())
+            || !old.permit().terms().equals(request.terms()))
+          throw new IllegalArgumentException(
+              "Transit request ID conflicts with its durable receipt");
+        return old;
+      }
+      long now = clock.millis();
+      if (receipts.size() >= MAX_RECEIPTS / 2)
+        throw new IllegalStateException(
+            "Transit approval capacity reached; remaining slots are reserved for revocation");
+      if (request.terms().expiresAt() <= now || request.terms().expiresAt() - now > MAX_LIFETIME)
+        throw new IllegalArgumentException("Transit expiry must be within the next thirty days");
+      String limitation = authority.limitation(request.terms());
+      if (limitation != null) throw new IllegalStateException(limitation);
+      Key key = key(request.terms());
+      Permit current = permits.get(key);
+      if ((current == null ? 0 : current.revision()) != request.expectedRevision())
+        throw new IllegalStateException("Transit permission revision changed");
+      if (current != null && now < current.updatedAt())
+        throw new IllegalStateException("Transit clock moved backwards");
+      long count =
+          permits.values().stream()
+              .filter(
+                  p ->
+                      p.terms().grantingNation().equals(request.terms().grantingNation())
+                          && !p.revoked()
+                          && p.terms().expiresAt() > now
+                          && !key(p.terms()).equals(key))
+              .count();
+      if (count >= MAX_ACTIVE_PER_NATION)
+        throw new IllegalStateException("Active transit permission limit reached");
+      Permit next =
+          new Permit(
+              request.terms(),
+              Math.addExact(request.expectedRevision(), 1),
+              false,
+              request.actor(),
+              now);
+      return commit(
+          new Receipt(request.requestId(), Action.APPROVE, request.expectedRevision(), next));
+    }
+  }
+
+  @Override
+  public Receipt revoke(Revocation request) {
+    Objects.requireNonNull(request);
+    check();
+    synchronized (lock) {
+      authority.requireFounder(request.actor(), request.grantingNation());
+      Receipt old = receipts.get(request.requestId());
+      if (old != null) {
+        if (old.action() != Action.REVOKE
+            || old.expectedRevision() != request.expectedRevision()
+            || !old.permit().actor().equals(request.actor())
+            || !old.permit().terms().routeKey().equals(request.routeKey())
+            || !old.permit().terms().grantingNation().equals(request.grantingNation()))
+          throw new IllegalArgumentException(
+              "Transit request ID conflicts with its durable receipt");
+        return old;
+      }
+      Permit current = permits.get(new Key(request.routeKey(), request.grantingNation()));
+      if (current == null || current.revision() != request.expectedRevision())
+        throw new IllegalStateException("Transit permission revision changed");
+      if (current.revoked())
+        throw new IllegalStateException("Transit permission is already revoked");
+      if (clock.millis() < current.updatedAt())
+        throw new IllegalStateException("Transit clock moved backwards");
+      return commit(
+          new Receipt(
+              request.requestId(),
+              Action.REVOKE,
+              request.expectedRevision(),
+              new Permit(
+                  current.terms(),
+                  Math.addExact(current.revision(), 1),
+                  true,
+                  request.actor(),
+                  clock.millis())));
+    }
+  }
+
+  private Receipt commit(Receipt receipt) {
+    if (receipts.size() >= MAX_RECEIPTS)
+      throw new IllegalStateException(
+          "Transit receipt capacity reached; preserve history and review storage");
+    Map<Key, Permit> nextPermits = new LinkedHashMap<>(permits);
+    Map<UUID, Receipt> nextReceipts = new LinkedHashMap<>(receipts);
+    nextPermits.put(key(receipt.permit().terms()), receipt.permit());
+    nextReceipts.put(receipt.requestId(), receipt);
+    try {
+      persist.accept(encode(nextPermits, nextReceipts));
+    } catch (RuntimeException failure) {
+      storageUncertain = true;
+      throw failure;
+    }
+    permits = nextPermits;
+    receipts = nextReceipts;
+    return receipt;
+  }
+
+  @Override
+  public Optional<Receipt> receipt(UUID id) {
+    Objects.requireNonNull(id);
+    check();
+    synchronized (lock) {
+      return Optional.ofNullable(receipts.get(id));
+    }
+  }
+
+  @Override
+  public Optional<Permit> permit(String route, NationId nation) {
+    check();
+    Objects.requireNonNull(route);
+    Objects.requireNonNull(nation);
+    synchronized (lock) {
+      return Optional.ofNullable(permits.get(new Key(route, nation)));
+    }
+  }
+
+  @Override
+  public Decision evaluate(Terms expected, long revision) {
+    Objects.requireNonNull(expected);
+    check();
+    synchronized (lock) {
+      Permit value = permits.get(key(expected));
+      Optional<Permit> snapshot = Optional.ofNullable(value);
+      if (value == null) return new Decision(snapshot, false, "Transit permission is missing");
+      if (revision != value.revision() || !expected.equals(value.terms()))
+        return new Decision(snapshot, false, "Transit permission terms or revision changed");
+      if (value.revoked()) return new Decision(snapshot, false, "Transit permission was revoked");
+      if (clock.millis() < value.updatedAt() || clock.millis() >= value.terms().expiresAt())
+        return new Decision(snapshot, false, "Transit permission expired or clock moved backwards");
+      String limitation = authority.limitation(expected);
+      return new Decision(
+          snapshot,
+          limitation == null,
+          limitation == null ? "Current transit authority verified" : limitation);
+    }
+  }
+
+  private void check() {
+    thread.run();
+    if (closed || storageUncertain)
+      throw new IllegalStateException(
+          "Transit service is closed or requires verified storage reload");
+  }
+
+  void close() {
+    synchronized (lock) {
+      closed = true;
+    }
+  }
+
+  Properties properties() {
+    synchronized (lock) {
+      if (storageUncertain)
+        throw new IllegalStateException(
+            "Uncertain transit storage must be reloaded before further persistence");
+      return encode(permits, receipts);
+    }
+  }
+
+  /** Strict load: never turn a corrupt permission or receipt into implicitly allowed traffic. */
+  void restore(Properties data) {
+    synchronized (lock) {
+      storageUncertain = true;
+      if (!data.containsKey(PREFIX + "version")) {
+        if (data.stringPropertyNames().stream().anyMatch(k -> k.startsWith(PREFIX)))
+          throw new IllegalStateException("Unversioned transit state");
+        permits = new LinkedHashMap<>();
+        receipts = new LinkedHashMap<>();
+        storageUncertain = false;
+        return;
+      }
+      if (!"1".equals(data.getProperty(PREFIX + "version")))
+        throw new IllegalStateException("Unsupported transit schema");
+      Map<Key, Permit> loadedPermits = new LinkedHashMap<>();
+      Map<UUID, Receipt> loadedReceipts = new LinkedHashMap<>();
+      int count = count(data, PREFIX + "permits");
+      for (int i = 0; i < count; i++) {
+        Permit permit = decodePermit(data, PREFIX + "permit." + i + ".");
+        if (loadedPermits.put(key(permit.terms()), permit) != null)
+          throw new IllegalStateException("Duplicate transit permit");
+      }
+      int receiptCount = count(data, PREFIX + "receipts");
+      for (int i = 0; i < receiptCount; i++) {
+        String prefix = PREFIX + "receipt." + i + ".";
+        Receipt receipt =
+            new Receipt(
+                UUID.fromString(required(data, prefix + "id")),
+                Action.valueOf(required(data, prefix + "action")),
+                Long.parseLong(required(data, prefix + "expected")),
+                decodePermit(data, prefix + "result."));
+        if (loadedReceipts.put(receipt.requestId(), receipt) != null)
+          throw new IllegalStateException("Duplicate transit receipt");
+      }
+      Map<Key, TreeMap<Long, Receipt>> chains = new HashMap<>();
+      for (Receipt receipt : loadedReceipts.values()) {
+        Key key = key(receipt.permit().terms());
+        Permit current = loadedPermits.get(key);
+        if (current == null || receipt.permit().revision() > current.revision())
+          throw new IllegalStateException("Transit receipt has no matching current permit");
+        if (chains
+                .computeIfAbsent(key, ignored -> new TreeMap<>())
+                .put(receipt.permit().revision(), receipt)
+            != null)
+          throw new IllegalStateException("Conflicting transit receipts at one revision");
+      }
+      for (var entry : loadedPermits.entrySet()) {
+        TreeMap<Long, Receipt> chain = chains.get(entry.getKey());
+        Permit current = entry.getValue();
+        if (chain == null
+            || chain.size() != current.revision()
+            || chain.firstKey() != 1L
+            || !chain.lastEntry().getValue().permit().equals(current))
+          throw new IllegalStateException("Transit revision history is incomplete");
+        Permit previous = null;
+        for (Receipt receipt : chain.values()) {
+          Permit result = receipt.permit();
+          if (receipt.action() == Action.APPROVE
+              && (result.terms().expiresAt() <= result.updatedAt()
+                  || result.terms().expiresAt() - result.updatedAt() > MAX_LIFETIME))
+            throw new IllegalStateException("Transit approval history has invalid expiry");
+          if (previous != null
+              && (receipt.permit().updatedAt() < previous.updatedAt()
+                  || receipt.action() == Action.REVOKE
+                      && (previous.revoked()
+                          || !receipt.permit().terms().equals(previous.terms()))))
+            throw new IllegalStateException("Transit revocation history changed");
+          if (previous == null && receipt.action() != Action.APPROVE)
+            throw new IllegalStateException("Transit history must begin with approval");
+          previous = receipt.permit();
+        }
+      }
+      Properties canonical = encode(loadedPermits, loadedReceipts);
+      Set<String> actual = new HashSet<>();
+      data.stringPropertyNames().stream().filter(k -> k.startsWith(PREFIX)).forEach(actual::add);
+      if (!canonical.stringPropertyNames().equals(actual))
+        throw new IllegalStateException("Unexpected or incomplete transit fields");
+      permits = loadedPermits;
+      receipts = loadedReceipts;
+      storageUncertain = false;
+    }
+  }
+
+  private static Properties encode(Map<Key, Permit> permits, Map<UUID, Receipt> receipts) {
+    Properties out = new Properties();
+    out.setProperty(PREFIX + "version", "1");
+    out.setProperty(PREFIX + "permits", "" + permits.size());
+    out.setProperty(PREFIX + "receipts", "" + receipts.size());
+    int index = 0;
+    for (Permit permit :
+        permits.values().stream()
+            .sorted(
+                Comparator.comparing(p -> p.terms().routeKey() + ":" + p.terms().grantingNation()))
+            .toList()) encodePermit(out, PREFIX + "permit." + index++ + ".", permit);
+    index = 0;
+    for (Receipt receipt :
+        receipts.values().stream()
+            .sorted(Comparator.comparing(r -> r.requestId().toString()))
+            .toList()) {
+      String prefix = PREFIX + "receipt." + index++ + ".";
+      out.setProperty(prefix + "id", receipt.requestId().toString());
+      out.setProperty(prefix + "action", receipt.action().name());
+      out.setProperty(prefix + "expected", "" + receipt.expectedRevision());
+      encodePermit(out, prefix + "result.", receipt.permit());
+    }
+    return out;
+  }
+
+  private static void encodePermit(Properties out, String p, Permit value) {
+    Terms t = value.terms();
+    out.setProperty(p + "route", t.routeKey());
+    out.setProperty(p + "fingerprint", t.fingerprint());
+    out.setProperty(p + "grantor", t.grantingNation().toString());
+    out.setProperty(p + "origin", t.originNation().toString());
+    out.setProperty(p + "target", t.targetNation().toString());
+    out.setProperty(p + "toll", t.tollPerUnit().toPlainString());
+    out.setProperty(p + "expiry", "" + t.expiresAt());
+    out.setProperty(p + "revision", "" + value.revision());
+    out.setProperty(p + "revoked", "" + value.revoked());
+    out.setProperty(p + "actor", value.actor().toString());
+    out.setProperty(p + "updated", "" + value.updatedAt());
+    out.setProperty(p + "parcels", "" + t.parcels().size());
+    int index = 0;
+    for (Parcel parcel :
+        t.parcels().stream()
+            .sorted(Comparator.comparingInt(Parcel::chunkX).thenComparingInt(Parcel::chunkZ))
+            .toList()) {
+      String q = p + "parcel." + index++ + ".";
+      out.setProperty(q + "world", parcel.worldId().toString());
+      out.setProperty(q + "name", parcel.worldName());
+      out.setProperty(q + "city", parcel.cityId().toString());
+      out.setProperty(q + "x", "" + parcel.chunkX());
+      out.setProperty(q + "z", "" + parcel.chunkZ());
+    }
+  }
+
+  private static Permit decodePermit(Properties data, String p) {
+    int count = Integer.parseInt(required(data, p + "parcels"));
+    if (count < 1 || count > MAX_PARCELS)
+      throw new IllegalStateException("Transit parcel count exceeds bound");
+    Set<Parcel> parcels = new LinkedHashSet<>();
+    for (int i = 0; i < count; i++) {
+      String q = p + "parcel." + i + ".";
+      if (!parcels.add(
+          new Parcel(
+              UUID.fromString(required(data, q + "world")),
+              required(data, q + "name"),
+              UUID.fromString(required(data, q + "city")),
+              Integer.parseInt(required(data, q + "x")),
+              Integer.parseInt(required(data, q + "z")))))
+        throw new IllegalStateException("Duplicate transit parcel");
+    }
+    Terms terms =
+        new Terms(
+            required(data, p + "route"),
+            required(data, p + "fingerprint"),
+            NationId.of(UUID.fromString(required(data, p + "grantor"))),
+            NationId.of(UUID.fromString(required(data, p + "origin"))),
+            NationId.of(UUID.fromString(required(data, p + "target"))),
+            parcels,
+            new BigDecimal(required(data, p + "toll")),
+            Long.parseLong(required(data, p + "expiry")));
+    String revoked = required(data, p + "revoked");
+    if (!Set.of("true", "false").contains(revoked))
+      throw new IllegalStateException("Invalid transit revocation flag");
+    return new Permit(
+        terms,
+        Long.parseLong(required(data, p + "revision")),
+        Boolean.parseBoolean(revoked),
+        UUID.fromString(required(data, p + "actor")),
+        Long.parseLong(required(data, p + "updated")));
+  }
+
+  private static Key key(Terms terms) {
+    return new Key(terms.routeKey(), terms.grantingNation());
+  }
+
+  private static int count(Properties data, String key) {
+    int count = Integer.parseInt(required(data, key));
+    if (count < 0 || count > MAX_RECEIPTS)
+      throw new IllegalStateException("Transit state count exceeds bound");
+    return count;
+  }
+
+  private static String required(Properties data, String key) {
+    String value = data.getProperty(key);
+    if (value == null || value.isBlank())
+      throw new IllegalStateException("Missing transit field " + key);
+    return value;
+  }
+}
diff --git a/src/main/java/dev/starcore/starcore/module/diplomacy/TransitPermitService.java b/src/main/java/dev/starcore/starcore/module/diplomacy/TransitPermitService.java
new file mode 100644
index 00000000..03c8b916
--- /dev/null
+++ b/src/main/java/dev/starcore/starcore/module/diplomacy/TransitPermitService.java
@@ -0,0 +1,145 @@
+package dev.starcore.starcore.module.diplomacy;
+
+import dev.starcore.starcore.module.nation.model.NationId;
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.*;
+
+/**
+ * Authoritative, versioned permission for one explicit foreign trade corridor. All calls require
+ * the Paper main thread. Returned values are immutable. A permit does not transfer money; callers
+ * must settle any quoted toll separately and atomically.
+ */
+public interface TransitPermitService {
+  int MAX_PARCELS = 128;
+  int MAX_ACTIVE_PER_NATION = 64;
+
+  record Parcel(UUID worldId, String worldName, UUID cityId, int chunkX, int chunkZ) {
+    public Parcel {
+      Objects.requireNonNull(worldId, "worldId");
+      Objects.requireNonNull(cityId, "cityId");
+      if (worldName == null
+          || worldName.isBlank()
+          || worldName.length() > 128
+          || Math.abs((long) chunkX) > 1_875_000
+          || Math.abs((long) chunkZ) > 1_875_000)
+        throw new IllegalArgumentException("Invalid transit parcel");
+    }
+  }
+
+  record Terms(
+      String routeKey,
+      String fingerprint,
+      NationId grantingNation,
+      NationId originNation,
+      NationId targetNation,
+      Set<Parcel> parcels,
+      BigDecimal tollPerUnit,
+      long expiresAt) {
+    public Terms {
+      routeKey = TransitPermitService.routeKey(routeKey);
+      if (fingerprint == null || !fingerprint.matches("[a-f0-9]{64}"))
+        throw new IllegalArgumentException("A corridor fingerprint is required");
+      Objects.requireNonNull(grantingNation, "grantingNation");
+      Objects.requireNonNull(originNation, "originNation");
+      Objects.requireNonNull(targetNation, "targetNation");
+      if (grantingNation.equals(originNation) || grantingNation.equals(targetNation))
+        throw new IllegalArgumentException("Transit permission requires a third nation");
+      if (parcels == null || parcels.isEmpty() || parcels.size() > MAX_PARCELS)
+        throw new IllegalArgumentException("Transit permits cover one to 128 claimed parcels");
+      parcels = Set.copyOf(parcels);
+      UUID world = parcels.iterator().next().worldId();
+      String name = parcels.iterator().next().worldName();
+      if (parcels.stream().anyMatch(p -> !p.worldId().equals(world) || !p.worldName().equals(name))
+          || parcels.stream().map(p -> p.chunkX() + ":" + p.chunkZ()).distinct().count()
+              != parcels.size())
+        throw new IllegalArgumentException(
+            "Transit parcels require one world and unique coordinates");
+      Objects.requireNonNull(tollPerUnit, "tollPerUnit");
+      if (tollPerUnit.scale() > 64
+          || tollPerUnit.precision() > 80
+          || tollPerUnit.signum() < 0
+          || tollPerUnit.compareTo(new BigDecimal("1000000.00")) > 0
+          || expiresAt < 0) throw new IllegalArgumentException("Invalid transit toll or expiry");
+      tollPerUnit = tollPerUnit.setScale(2, RoundingMode.UNNECESSARY);
+    }
+  }
+
+  record Permit(Terms terms, long revision, boolean revoked, UUID actor, long updatedAt) {
+    public Permit {
+      Objects.requireNonNull(terms, "terms");
+      Objects.requireNonNull(actor, "actor");
+      if (revision < 1 || updatedAt < 0)
+        throw new IllegalArgumentException("Invalid permit revision");
+    }
+  }
+
+  enum Action {
+    APPROVE,
+    REVOKE
+  }
+
+  record Approval(UUID requestId, UUID actor, long expectedRevision, Terms terms) {
+    public Approval {
+      Objects.requireNonNull(requestId, "requestId");
+      Objects.requireNonNull(actor, "actor");
+      Objects.requireNonNull(terms, "terms");
+      if (expectedRevision < 0) throw new IllegalArgumentException("Negative revision");
+    }
+  }
+
+  record Revocation(
+      UUID requestId, UUID actor, long expectedRevision, String routeKey, NationId grantingNation) {
+    public Revocation {
+      Objects.requireNonNull(requestId, "requestId");
+      Objects.requireNonNull(actor, "actor");
+      Objects.requireNonNull(grantingNation, "grantingNation");
+      routeKey = TransitPermitService.routeKey(routeKey);
+      if (expectedRevision < 1) throw new IllegalArgumentException("Missing permit revision");
+    }
+  }
+
+  /**
+   * Durable operation receipt; replay returns this original result, never reinstates old rights.
+   */
+  record Receipt(UUID requestId, Action action, long expectedRevision, Permit permit) {
+    public Receipt {
+      Objects.requireNonNull(requestId, "requestId");
+      Objects.requireNonNull(action, "action");
+      Objects.requireNonNull(permit, "permit");
+      if (expectedRevision < 0
+          || permit.revision() != Math.addExact(expectedRevision, 1)
+          || (action == Action.REVOKE) != permit.revoked())
+        throw new IllegalArgumentException("Invalid transit operation receipt");
+    }
+  }
+
+  record Decision(Optional<Permit> permit, boolean allowed, String detail) {
+    public Decision {
+      permit = Objects.requireNonNull(permit, "permit");
+      Objects.requireNonNull(detail, "detail");
+      if (detail.length() > 512 || allowed && (permit.isEmpty() || permit.get().revoked()))
+        throw new IllegalArgumentException("Invalid transit decision");
+    }
+  }
+
+  Receipt approve(Approval request);
+
+  Receipt revoke(Revocation request);
+
+  Optional<Receipt> receipt(UUID requestId);
+
+  Optional<Permit> permit(String routeKey, NationId grantingNation);
+
+  /**
+   * Checks the exact expected revision and immutable terms, current city/national claims and
+   * current peaceful relations with both endpoints. Missing services or unloaded worlds deny.
+   */
+  Decision evaluate(Terms expected, long expectedRevision);
+
+  private static String routeKey(String key) {
+    if (key == null || !key.matches("[a-zA-Z0-9:_-]{1,160}"))
+      throw new IllegalArgumentException("Invalid transit route key");
+    return key;
+  }
+}
diff --git a/src/test/java/dev/starcore/starcore/module/diplomacy/CoreTransitAuthorityTest.java b/src/test/java/dev/starcore/starcore/module/diplomacy/CoreTransitAuthorityTest.java
new file mode 100644
index 00000000..7ea93134
