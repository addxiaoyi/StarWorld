+  @Test
+  void actualSqliteSnapshotsPreserveOtherDiplomacyFamiliesAndRejectStaleWriters() {
+    HikariConfig config = new HikariConfig();
+    config.setJdbcUrl("jdbc:sqlite:" + temp.resolve("transit.db"));
+    config.setMaximumPoolSize(1);
+    try (HikariDataSource database = new HikariDataSource(config)) {
+      var first = sql(database);
+      var second = sql(database);
+      var auth = new Authority();
+      var one = ledger(auth, first::save, first.load(), clock);
+      var two = ledger(auth, second::save, second.load(), clock);
+      Approval approved = approval(terms("route"), 0);
+      one.approve(approved);
+      assertThatThrownBy(() -> two.approve(approval(terms("other"), 0)))
+          .isInstanceOf(DiplomacyStateConflictException.class);
+      assertThatThrownBy(two::properties).hasMessageContaining("Uncertain");
+      Properties saved = first.load();
+      var merged = new MergingDiplomacyStateStorage(sql(database));
+      merged.load();
+      Properties relation = new Properties();
+      relation.setProperty("count", "0");
+      relation.setProperty("warCount", "0");
+      merged.save(relation);
+      var restarted = ledger(auth, merged::save, merged.load(), clock);
+      assertThat(restarted.approve(approved).permit().revision()).isEqualTo(1);
+      restarted.revoke(new Revocation(UUID.randomUUID(), actor, 1, "route", grantor));
+      Properties finalState = merged.load();
+      assertThat(finalState).containsEntry("count", "0").containsEntry("warCount", "0");
+      var last =
+          ledger(
+              auth,
+              ignored -> {
+                throw new AssertionError("read-only restart");
+              },
+              finalState,
+              clock);
+      assertThat(last.evaluate(terms("route"), 1).allowed()).isFalse();
+      assertThat(last.permit("route", grantor).orElseThrow().revision()).isEqualTo(2);
+      assertThat(saved.getProperty("transit.receipts")).isEqualTo("1");
+    }
+  }
+
+  private SqlDiplomacyStateStorage sql(HikariDataSource database) {
+    return new SqlDiplomacyStateStorage(
+        () -> Optional.of(database), Properties::new, Logger.getLogger("transit-test"));
+  }
